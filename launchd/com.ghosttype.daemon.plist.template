<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Ghost Type launchd agent. Install:
    1. Replace __NODE__ with `which node`, __GHOST__ with the absolute path to bin/ghost.mjs,
       and __HOME__ with your home dir (launchd jobs get a minimal PATH, so use absolute paths).
    2. cp this to ~/Library/LaunchAgents/com.ghosttype.daemon.plist
    3. launchctl load ~/Library/LaunchAgents/com.ghosttype.daemon.plist
  This runs `ghost on` with no send-off at the scheduled hour, which falls back to
  continuing the most-recent project. Remove the StartCalendarInterval to disable auto-arm.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ghosttype.daemon</string>

  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__GHOST__</string>
    <string>on</string>
  </array>

  <!-- Auto-arm at 23:00 nightly. Delete this block to require explicit `ghost on`. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>23</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin:__HOME__/.local/bin</string>
    <key>HOME</key>
    <string>__HOME__</string>
  </dict>

  <key>StandardOutPath</key>
  <string>__HOME__/.ghosttype/daemon.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.ghosttype/daemon.err.log</string>
</dict>
</plist>
